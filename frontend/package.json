{
  "name": "nba-rockets-ai-analytics-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "ng serve --host 0.0.0.0 --port 4300",
    "build": "ng build",
    "demo:sync": "node scripts/generate-demo-catalog.mjs",
    "demo:validate": "node scripts/validate-demo-catalog.mjs",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "e2e": "playwright test",
    "lighthouse": "npm run build && node scripts/run-lighthouse.mjs",
    "pages:prepare": "node scripts/prepare-pages.mjs"
  },
  "dependencies": {
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.1",
    "@angular/cli": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "jsdom": "27.0.0",
    "lighthouse": "^13.5.0",
    "typescript": "6.0.2",
    "vitest": "4.1.11"
  }
}
